# Copy to .env.local for local dev. On Vercel, set these in Project Settings -> Environment Variables.

# --- Core -------------------------------------------------------------------
# postgres://... for Neon/Supabase (production). For zero-setup local dev use
# the embedded database: pglite:./.data/pglite  (auto-migrated and seeded)
DATABASE_URL=pglite:./.data/pglite
# The single password for the dashboard.
APP_PASSWORD=
# Public URL of the app (used in notification links and the Strava callback).
APP_BASE_URL=http://localhost:3000
# Signs approval links and session cookies. Generate: openssl rand -hex 32
APPROVAL_SIGNING_SECRET=
# Encrypts Strava tokens at rest. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Strava (https://www.strava.com/settings/api) ----------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; Strava echoes it back when you register the webhook.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# --- Checkout providers ------------------------------------------------------
# cart | mock | browser | crossmint | rye. cart (default) = open the store's own checkout link; you click Pay.
#   browser = Claude drives a visible Chrome window on this PC, using the account
#   and card saved at your store. With PURCHASES_ENABLED=false it's a dry run
#   (stops at the review page). Other real providers need PURCHASES_ENABLED=true.
CHECKOUT_PROVIDER=cart
BROWSER_AGENT_MODEL=claude-sonnet-5
# Chrome profile for the shopping agent (sign in to your store here once, via Settings).
SHOPPING_PROFILE_DIR=.data/shopping-profile
# Seconds between Claude's pick and the automatic purchase after "Sync runs".
SYNC_COUNTDOWN_S=10
# Crossmint server-side PRODUCTION key (sk_production_...). Agent Checkouts has no staging.
CROSSMINT_API_KEY=
CROSSMINT_BASE_URL=https://www.crossmint.com
# Rye: staging key for testing. Rye ships to US addresses only.
RYE_API_KEY=
RYE_BASE_URL=https://staging.api.rye.com

# --- Notifications (https://ntfy.sh) -----------------------------------------
# Pick a long, unguessable topic name; anyone who knows it can read your notifications.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Optional access token if you use a reserved/protected topic.
NTFY_TOKEN=

# --- Guardrails ----------------------------------------------------------------
# Global kill switch. While false, no real provider is ever called.
PURCHASES_ENABLED=false
# Allow purchases without tapping Approve (also needs the toggle in /settings).
AUTO_BUY=false
# Caps in CAD. These are ceilings; /settings can only tighten them.
MAX_ORDER_CAD=40
MAX_DAILY_CAD=60
MAX_WEEKLY_CAD=100
AUTO_BUY_MAX_CAD=15
# Activities faster than this average speed are flagged (probably a bike or car).
MAX_RUN_SPEED_KMH=20
# Shows the "Simulate run" button. Set false in production once you're done filming.
DEMO_TOOLS_ENABLED=true

# --- COROS (runs source) --------------------------------------------------------
# No keys needed: click "Connect COROS" in Settings. New runs are found by polling
# /api/coros/poll. Protect it for an external cron with this secret
# (send "Authorization: Bearer <CRON_SECRET>"). Generate: openssl rand -hex 24
CRON_SECRET=

# Only for organization-level keys not scoped to a workspace (Console → Settings → Workspaces).
ANTHROPIC_WORKSPACE_ID=
